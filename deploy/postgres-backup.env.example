# Optional overrides for shooting-postgres-backup.service.
# The backup script reads DATABASE_URL from /home/ubuntu/shooting-system/backend/.env.

BACKUP_DIR=/home/ubuntu/backups/shooting-system/postgres
RETENTION_DAYS=14
MIN_BACKUPS=3

# Optional off-VPS copy hook. BACKUP_FILE and BACKUP_DIR are exported for the command.
# Example:
# REMOTE_SYNC_COMMAND=scp "$BACKUP_FILE" backups@example.com:/srv/backups/shooting-system/postgres/
REMOTE_SYNC_COMMAND=
